rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(request.auth.uid)); }
    function isOfficer() { return signedIn() && request.auth.token.email == "officer@lgu-cortes.local"; }
    function isStaff() { return signedIn() && staffDoc().data.active == true; }
    function isStaffFor(dept) { return isStaff() && staffDoc().data.department == dept; }

    match /lgu_profiles/{uid} {
      allow create: if isOwner(uid);
      allow read, update: if isOwner(uid);
      allow delete: if false;
    }

    match /staff/{uid} {
      allow read: if isOwner(uid);
      allow create, update, delete: if false;
    }

    match /schedule_availability/{dateId} {
      allow read: if signedIn();
      allow create, delete: if isOfficer() || isStaff();
      // Staff/Officer may configure the individual enabled times and admin counters.
      allow update: if isOfficer() || isStaff()
        || (signedIn()
            && request.resource.data.department == resource.data.department
            && request.resource.data.date == resource.data.date
            && request.resource.data.available == resource.data.available
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt','booked_0800','booked_0900','booked_1000','booked_1100','booked_1300','booked_1400','booked_1500','booked_1600','booked_1700'])
            && (
              (resource.data.keys().hasAll(['booked_0800']) && request.resource.data.booked_0800 == resource.data.booked_0800 + 1) ||
              (!resource.data.keys().hasAll(['booked_0800']) && request.resource.data.booked_0800 == 1) ||
              (resource.data.keys().hasAll(['booked_0900']) && request.resource.data.booked_0900 == resource.data.booked_0900 + 1) ||
              (!resource.data.keys().hasAll(['booked_0900']) && request.resource.data.booked_0900 == 1) ||
              (resource.data.keys().hasAll(['booked_1000']) && request.resource.data.booked_1000 == resource.data.booked_1000 + 1) ||
              (!resource.data.keys().hasAll(['booked_1000']) && request.resource.data.booked_1000 == 1) ||
              (resource.data.keys().hasAll(['booked_1100']) && request.resource.data.booked_1100 == resource.data.booked_1100 + 1) ||
              (!resource.data.keys().hasAll(['booked_1100']) && request.resource.data.booked_1100 == 1) ||
              (resource.data.keys().hasAll(['booked_1300']) && request.resource.data.booked_1300 == resource.data.booked_1300 + 1) ||
              (!resource.data.keys().hasAll(['booked_1300']) && request.resource.data.booked_1300 == 1) ||
              (resource.data.keys().hasAll(['booked_1400']) && request.resource.data.booked_1400 == resource.data.booked_1400 + 1) ||
              (!resource.data.keys().hasAll(['booked_1400']) && request.resource.data.booked_1400 == 1) ||
              (resource.data.keys().hasAll(['booked_1500']) && request.resource.data.booked_1500 == resource.data.booked_1500 + 1) ||
              (!resource.data.keys().hasAll(['booked_1500']) && request.resource.data.booked_1500 == 1) ||
              (resource.data.keys().hasAll(['booked_1600']) && request.resource.data.booked_1600 == resource.data.booked_1600 + 1) ||
              (!resource.data.keys().hasAll(['booked_1600']) && request.resource.data.booked_1600 == 1) ||
              (resource.data.keys().hasAll(['booked_1700']) && request.resource.data.booked_1700 == resource.data.booked_1700 + 1) ||
              (!resource.data.keys().hasAll(['booked_1700']) && request.resource.data.booked_1700 == 1)
            )
            && request.resource.data.booked_0800 <= 5
            && request.resource.data.booked_0900 <= 5
            && request.resource.data.booked_1000 <= 5
            && request.resource.data.booked_1100 <= 5
            && request.resource.data.booked_1300 <= 5
            && request.resource.data.booked_1400 <= 5
            && request.resource.data.booked_1500 <= 5
            && request.resource.data.booked_1600 <= 5
            && request.resource.data.booked_1700 <= 5);
    }

    match /lgu_requests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.status == 'Pending';
      allow read: if (signedIn() && resource.data.uid == request.auth.uid)
        || isOfficer()
        || (isStaffFor(resource.data.department));
      allow update: if isOfficer() || isStaffFor(resource.data.department)
        || (signedIn() && resource.data.uid == request.auth.uid
            && resource.data.status == 'Pending'
            && request.resource.data.status == 'Cancelled'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']));
      allow delete: if isOfficer() || isStaffFor(resource.data.department);
    }
  }
}
